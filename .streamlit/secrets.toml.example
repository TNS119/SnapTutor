# Copy this file to secrets.toml and replace each placeholder locally.
# Never commit .streamlit/secrets.toml or share its contents.

GEMINI_API_KEY = "replace-with-your-gemini-api-key"

TWILIO_ACCOUNT_SID = "replace-with-your-twilio-account-sid"
TWILIO_AUTH_TOKEN = "replace-with-your-twilio-auth-token"
TWILIO_CONTENT_SID = "replace-with-your-approved-content-sid"
TWILIO_WHATSAPP_FROM = "whatsapp:+replace-with-your-twilio-sender-number"

GMAIL_ADDRESS = "replace-with-your-sender@gmail.com"
GMAIL_APP_PASSWORD = "replace-with-your-google-app-password"

TELEGRAM_BOT_TOKEN = "replace-with-your-botfather-token"
